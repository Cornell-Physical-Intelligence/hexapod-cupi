#!/usr/bin/env bash
set -euo pipefail

workspace_host=/home/orionh/HEXAPOD
workspace_container=/workspace/hexapod
isaac_lab_dir=/home/orionh/IsaacLab
default_task=Isaac-Velocity-Omni-Warmup-Hexapod-RobStride-Direct-v0

if [[ $# -lt 1 || $# -gt 3 ]]; then
  echo "usage: $0 CHECKPOINT_HOST_PATH [ARTIFACT_HOST_DIR] [TASK_ID]" >&2
  exit 64
fi

checkpoint_host=$(realpath "$1")
if [[ ! -f "${checkpoint_host}" ]]; then
  echo "checkpoint does not exist: ${checkpoint_host}" >&2
  exit 1
fi
case "${checkpoint_host}" in
  "${workspace_host}"/*) ;;
  *)
    echo "checkpoint must be below ${workspace_host}: ${checkpoint_host}" >&2
    exit 1
    ;;
esac
checkpoint_container="${workspace_container}/${checkpoint_host#"${workspace_host}/"}"

checkpoint_stem=$(basename "${checkpoint_host}" .pt)
artifact_host_dir=${2:-"${workspace_host}/artifacts/phase2_warmup/showcase/${checkpoint_stem}"}
mkdir -p "${artifact_host_dir}"
artifact_host_dir=$(realpath "${artifact_host_dir}")
case "${artifact_host_dir}" in
  "${workspace_host}"/*) ;;
  *)
    echo "artifact directory must be below ${workspace_host}: ${artifact_host_dir}" >&2
    exit 1
    ;;
esac
artifact_container_dir="${workspace_container}/${artifact_host_dir#"${workspace_host}/"}"
task_id=${3:-${default_task}}

chmod 0777 "${artifact_host_dir}"
cd "${isaac_lab_dir}"

docker compose \
  --env-file docker/.env.base \
  -f docker/docker-compose.yaml \
  --profile base \
  run \
  --rm \
  --name hexapod-phase2-showcase \
  -w /workspace/hexapod/isaaclab \
  -e PYTHONPATH=/workspace/hexapod/isaaclab \
  -e PYTHONDONTWRITEBYTECODE=1 \
  -v /home/orionh/HEXAPOD:/workspace/hexapod:rw \
  --entrypoint /workspace/isaaclab/_isaac_sim/python.sh \
  isaac-lab-base \
  /workspace/hexapod/isaaclab/showcase_phase2.py \
  --kit_args="--/exts/omni.kit.telemetry/skipDeferredStartup=true --/app/extensions/excluded/4=omni.kit.telemetry" \
  --task "${task_id}" \
  --checkpoint "${checkpoint_container}" \
  --stand-seconds 2 \
  --motion-seconds 3 \
  --settle-seconds 0.5 \
  --seed 54 \
  --disable-randomization \
  --video \
  --follow-camera \
  --camera-eye 0.90 1.05 0.58 \
  --camera-lookat 0 0 0.15 \
  --camera-follow-time-constant 0.20 \
  --camera-horizontal-fov-deg 72 \
  --video-resolution 1920 1080 \
  --video-dir "${artifact_container_dir}" \
  --json "${artifact_container_dir}/metrics.json" \
  --fail-on-rejection \
  >"${artifact_host_dir}/record.log" 2>&1
