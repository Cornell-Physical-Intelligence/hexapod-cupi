#!/usr/bin/env bash
set -euo pipefail

# Screen one complete Stage2E run against fixed reverse-only, pivot-yaw,
# accepted-anchor, and combined joystick commands in one Kit process.

isaac_lab_dir=/home/orionh/IsaacLab
workspace_host=/home/orionh/HEXAPOD
workspace_container=/workspace/hexapod
screen_container=hexapod-stage2e-joystick-static-screen
screen_lock=/tmp/hexapod-stage2e-joystick-static-screen.lock

usage() {
  echo "usage: $0 E0|E1|E2 exact-run-directory /absolute/staged/seed.pt seed-sha256" >&2
  exit 64
}

(( $# == 4 )) || usage
stage=${1^^}
run_name=$2
seed_host=$3
expected_seed_sha256=${4,,}

case "${stage}" in
  E0)
    task_id=Isaac-Velocity-Omni-Recovery-Stage2E-Joystick-E0-Hexapod-RobStride-Direct-v0
    experiment=hexapod_robstride_phase2_recovery_stage2e_e0_joystick_bridge_direct
    evaluation_seed=72
    checkpoint_numbers=(0 5 10 15 20 25 29)
    reverse_mid=0.035
    yaw_bridge_forward=0.17
    joystick_forward=0.15
    joystick_lateral=0.07
    joystick_yaw=0.17
    ;;
  E1)
    task_id=Isaac-Velocity-Omni-Recovery-Stage2E-Joystick-E1-Hexapod-RobStride-Direct-v0
    experiment=hexapod_robstride_phase2_recovery_stage2e_e1_reverse_bridge_direct
    evaluation_seed=73
    checkpoint_numbers=(0 5 10 15 20 25 30 34)
    reverse_mid=0.07
    yaw_bridge_forward=0.075
    joystick_forward=0.155
    joystick_lateral=0.07
    joystick_yaw=0.17
    ;;
  E2)
    task_id=Isaac-Velocity-Omni-Recovery-Stage2E-Joystick-E2-Hexapod-RobStride-Direct-v0
    experiment=hexapod_robstride_phase2_recovery_stage2e_e2_joystick_direct
    evaluation_seed=74
    checkpoint_numbers=(0 5 10 15 20 25 30 35 40 44)
    reverse_mid=0.14
    yaw_bridge_forward=0.0
    joystick_forward=0.165
    joystick_lateral=0.065
    joystick_yaw=0.17
    ;;
  *) usage ;;
esac

if [[ ! "${run_name}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
  || [[ "${run_name}" == "." || "${run_name}" == ".." ]] \
  || [[ "${run_name,,}" != *"stage2e_e${stage#E}"* ]]; then
  echo "exact run name must safely identify stage2e_e${stage#E}: ${run_name@Q}" >&2
  exit 64
fi
if [[ ! "${expected_seed_sha256}" =~ ^[0-9a-f]{64}$ ]]; then
  echo "seed SHA-256 must be exactly 64 hexadecimal characters" >&2
  exit 64
fi
if [[ "${seed_host}" != /* || "${seed_host}" == *"/../"* \
  || "${seed_host}" == */.. || "${seed_host}" != *.pt ]]; then
  echo "seed must be an explicit absolute .pt path without traversal" >&2
  exit 64
fi
for required_command in docker python3 sha256sum flock grep realpath tee; do
  command -v "${required_command}" >/dev/null 2>&1 || {
    echo "required command is unavailable: ${required_command}" >&2
    exit 69
  }
done
if [[ ! -d "${isaac_lab_dir}" || ! -d "${workspace_host}/isaaclab" ]]; then
  echo "Spark workspace or Isaac Lab checkout is missing" >&2
  exit 66
fi

experiment_host=${workspace_host}/isaaclab/logs/rsl_rl/${experiment}
experiment_container=${workspace_container}/isaaclab/logs/rsl_rl/${experiment}
run_host=${experiment_host}/${run_name}
run_container=${experiment_container}/${run_name}
if [[ ! -d "${run_host}" || -L "${run_host}" ]] \
  || [[ "$(realpath -e -- "${run_host}")" != "${run_host}" ]]; then
  echo "exact run directory must be canonical and non-symlink: ${run_host}" >&2
  exit 66
fi
if [[ ! -f "${seed_host}" || -L "${seed_host}" ]] \
  || [[ "$(realpath -e -- "${seed_host}")" != "${seed_host}" ]]; then
  echo "immutable seed must be canonical and non-symlink: ${seed_host}" >&2
  exit 66
fi
seed_parent=${seed_host%/*}
seed_directory=${seed_parent##*/}
seed_filename=${seed_host##*/}
if [[ "${seed_parent%/*}" != "${experiment_host}" ]] \
  || [[ ! "${seed_directory}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
  || [[ ! "${seed_filename}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*[.]pt$ ]]; then
  echo "seed must be one safe staged child of ${experiment_host}" >&2
  exit 64
fi
seed_container=${experiment_container}/${seed_directory}/${seed_filename}

verify_seed() {
  local label=$1 actual_sha256
  if [[ ! -f "${seed_host}" || -L "${seed_host}" ]]; then
    echo "${label}: immutable seed disappeared or became a symlink" >&2
    exit 65
  fi
  actual_sha256=$(sha256sum -- "${seed_host}")
  actual_sha256=${actual_sha256%% *}
  if [[ "${actual_sha256}" != "${expected_seed_sha256}" ]]; then
    echo "${label}: immutable seed hash mismatch" >&2
    exit 65
  fi
}

active_training_unit() {
  command -v systemctl >/dev/null 2>&1 \
    && systemctl list-units --type=service --state=active --plain --no-legend \
      | grep -Eq '^[[:space:]]*hexapod-rl-training[^[:space:]]*[.]service[[:space:]]'
}

if active_training_unit; then
  echo "refusing to screen while generic training is active" >&2
  exit 75
fi
if docker ps --format '{{.Names}}' \
  | grep -Eq '^(hexapod-rl-training|hexapod-stage2[de]-)'; then
  echo "refusing an active training/screen container" >&2
  exit 75
fi
if docker ps -a --format '{{.Names}}' | grep -Fxq "${screen_container}"; then
  echo "refusing existing screen container: ${screen_container}" >&2
  exit 75
fi

exec 9>"${screen_lock}"
if ! flock -n 9; then
  echo "another Stage2E static screen holds ${screen_lock}" >&2
  exit 75
fi

checkpoint_args=(--checkpoint "${seed_container}")
checkpoint_host_paths=()
checkpoint_hashes=()
for iteration in "${checkpoint_numbers[@]}"; do
  checkpoint_host=${run_host}/model_${iteration}.pt
  if [[ ! -s "${checkpoint_host}" || -L "${checkpoint_host}" ]]; then
    echo "required dense checkpoint is missing, empty, or a symlink: ${checkpoint_host}" >&2
    exit 66
  fi
  checkpoint_host_paths+=("${checkpoint_host}")
  checkpoint_hash=$(sha256sum -- "${checkpoint_host}")
  checkpoint_hashes+=("${checkpoint_hash%% *}")
  checkpoint_args+=(--checkpoint "${run_container}/model_${iteration}.pt")
done
shopt -s nullglob
all_model_files=("${run_host}"/model_*.pt)
shopt -u nullglob
if (( ${#all_model_files[@]} != ${#checkpoint_numbers[@]} )); then
  echo "exact run must contain only the complete expected checkpoint set" >&2
  printf '  %s\n' "${all_model_files[@]}" >&2
  exit 65
fi

verify_run() {
  local label=$1 index actual_sha256
  for index in "${!checkpoint_host_paths[@]}"; do
    if [[ ! -f "${checkpoint_host_paths[index]}" || -L "${checkpoint_host_paths[index]}" ]]; then
      echo "${label}: checkpoint disappeared or became a symlink" >&2
      exit 65
    fi
    actual_sha256=$(sha256sum -- "${checkpoint_host_paths[index]}")
    actual_sha256=${actual_sha256%% *}
    if [[ "${actual_sha256}" != "${checkpoint_hashes[index]}" ]]; then
      echo "${label}: checkpoint changed: ${checkpoint_host_paths[index]}" >&2
      exit 65
    fi
  done
}

# Order is the grader contract: stable anchors, explicit reverse-only,
# accepted forward+yaw, staged yaw bridge, true pivots, then both x signs and
# all four y/yaw sign quadrants.
command_args=(
  --command 0.0 0.0 0.0
  --command 0.25 0.0 0.0
  --command "-${reverse_mid}" 0.0 0.0
  --command 0.0 0.09 0.0
  --command 0.0 -0.09 0.0
  --command 0.23 0.0 0.24
  --command 0.23 0.0 -0.24
)
if [[ "${stage}" != E2 ]]; then
  command_args+=(
    --command "${yaw_bridge_forward}" 0.0 0.24
    --command "${yaw_bridge_forward}" 0.0 -0.24
  )
fi
command_args+=(
  --command 0.0 0.0 0.24
  --command 0.0 0.0 -0.24
)
for vx in "${joystick_forward}" "-${reverse_mid}"; do
  for vy in "${joystick_lateral}" "-${joystick_lateral}"; do
    for yaw in "${joystick_yaw}" "-${joystick_yaw}"; do
      command_args+=(--command "${vx}" "${vy}" "${yaw}")
    done
  done
done

stage_lower=${stage,,}
artifact_host=${workspace_host}/artifacts/phase2_recovery_stage2e_joystick/${stage_lower}/static/${run_name}
artifact_container=${workspace_container}/artifacts/phase2_recovery_stage2e_joystick/${stage_lower}/static/${run_name}
eval_json=${artifact_host}/eval_static.json
eval_log=${artifact_host}/eval_static.log
grade_json=${artifact_host}/grade_static.json
grade_log=${artifact_host}/grade_static.log
if [[ -e "${artifact_host}" ]]; then
  echo "refusing to overwrite/reuse artifact directory: ${artifact_host}" >&2
  exit 73
fi
mkdir -p "${artifact_host}"
chmod 0777 "${artifact_host}"

verify_seed "before evaluation"
verify_run "before evaluation"
cd "${isaac_lab_dir}"
evaluation_status=0
docker compose \
  --env-file docker/.env.base \
  -f docker/docker-compose.yaml \
  --profile base \
  run \
  --rm \
  --name "${screen_container}" \
  -w /workspace/hexapod/isaaclab \
  -e PYTHONPATH=/workspace/hexapod/isaaclab \
  -e PYTHONDONTWRITEBYTECODE=1 \
  -v /home/orionh/HEXAPOD:/workspace/hexapod:rw \
  --entrypoint /workspace/isaaclab/_isaac_sim/python.sh \
  isaac-lab-base \
  "${workspace_container}/isaaclab/evaluate_checkpoint.py" \
  --kit_args="--/exts/omni.kit.telemetry/skipDeferredStartup=true --/app/extensions/excluded/4=omni.kit.telemetry" \
  --task "${task_id}" \
  "${checkpoint_args[@]}" \
  "${command_args[@]}" \
  --env-spacing 8.0 \
  --steps 500 \
  --warmup-steps 25 \
  --seed "${evaluation_seed}" \
  --disable-randomization \
  --json "${artifact_container}/eval_static.json" \
  >"${eval_log}" 2>&1 || evaluation_status=$?

verify_seed "after evaluation"
verify_run "after evaluation"
if (( evaluation_status != 0 )); then
  echo "Stage2E ${stage} evaluator failed with status ${evaluation_status}" >&2
  exit "${evaluation_status}"
fi
if [[ ! -s "${eval_json}" ]]; then
  echo "evaluator did not produce a non-empty report: ${eval_json}" >&2
  exit 65
fi

grade_status=0
python3 "${workspace_host}/isaaclab/grade_stage2e_static.py" \
  "${eval_json}" \
  --stage "${stage}" \
  --run-name "${run_name}" \
  --run-dir "${run_host}" \
  --seed-file "${seed_host}" \
  --seed-checkpoint "${seed_container}" \
  --seed-sha256 "${expected_seed_sha256}" \
  --json "${grade_json}" \
  2>&1 | tee "${grade_log}" || grade_status=$?

verify_seed "after grading"
verify_run "after grading"
exit "${grade_status}"
