#!/usr/bin/env bash
set -euo pipefail

unit=hexapod-rl-training.service
logs=/home/orionh/HEXAPOD/isaaclab/logs/rsl_rl/hexapod_robstride_flat_direct

case "${1:-status}" in
  omni-repair-pair)
    shift
    script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    exec python3 "$script_dir/../../tools/launch_omni_repair_pair_spark.py" "$@"
    ;;
  omni-repair)
    shift
    script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    exec python3 "$script_dir/../../tools/launch_omni_repair_spark.py" "$@"
    ;;
  terrain-smoke)
    shift
    script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    exec python3 "$script_dir/../../tools/launch_terrain_smoke_spark.py" "$@"
    ;;
  omni-diagnostics)
    shift
    script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    exec python3 "$script_dir/../../tools/launch_omni_diagnostics_spark.py" "$@"
    ;;
  omni-flat)
    shift
    script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    exec python3 "$script_dir/../../tools/launch_omni_flat_spark.py" "$@"
    ;;
  candidate-c)
    shift
    script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    exec python3 "$script_dir/../../tools/launch_candidate_c_spark.py" "$@"
    ;;
  length-study)
    shift
    script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    exec python3 "$script_dir/../../tools/launch_length_training_spark.py" "$@"
    ;;
  start)
    sudo systemctl start "$unit"
    ;;
  stop)
    sudo systemctl stop "$unit"
    ;;
  restart)
    sudo systemctl restart "$unit"
    ;;
  status)
    systemctl status "$unit" --no-pager
    ;;
  logs)
    journalctl -fu "$unit"
    ;;
  latest)
    find "$logs" -type f -name 'model_*.pt' -printf '%T@ %p\n' 2>/dev/null \
      | sort -nr | head -n 1 | cut -d' ' -f2-
    ;;
  runs)
    find "$logs" -mindepth 1 -maxdepth 1 -type d -printf '%TY-%Tm-%Td %TH:%TM %p\n' \
      | sort -r
    ;;
  *)
    echo "usage: hexapod-rl {start|stop|restart|status|logs|latest|runs|length-study --source PATH --output PATH}" >&2
    exit 2
    ;;
esac
