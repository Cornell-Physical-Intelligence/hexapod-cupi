# Third-party sources, pinned. See README.md for the import command.
# The driver and FAST-LIO revisions were set on 2026-11-16 to the ones then
# installed on the Jetson Nano.
repositories:
  Livox-SDK2:
    type: git
    url: https://github.com/Livox-SDK/Livox-SDK2.git
    version: c0796f04c143143899c87a773d9f6b7136453c0b
  livox_ros_driver2:
    type: git
    url: https://github.com/Livox-SDK/livox_ros_driver2.git
    version: 21445540f0d100dc86a7e6df312dd70bbdb4afdf
  FAST_LIO:
    type: git
    url: https://github.com/hku-mars/FAST_LIO.git
    version: a4743b095409588842a5b30ddfa27e29d2f99164
