  "glossary": [
    {
      "term": "Learned controller",
      "meaning": "A neural network, trained in simulation, that turns a requested speed and direction into targets for the 18 joints."
    },
    {
      "term": "Simulation",
      "meaning": "A physics model of the robot and the ground on a computer. We train and test there before we build hardware."
    },
    {
      "term": "Movement test",
      "meaning": "One fixed command, such as walking sideways at 5 cm/s or standing still, with limits on how closely the robot must follow it. We use 13."
    },
    {
      "term": "Training run",
      "meaning": "One complete training of the controller from scratch, started from one random seed."
    },
    {
      "term": "Tripod gait",
      "meaning": "A walking pattern that lifts three legs at a time while the other three carry the body."
    },
    {
      "term": "CAD",
      "meaning": "Computer-aided design: the 3D model of each part of the robot."
    }
  ]
}
