dist/
.DS_Store
*.log

# Generated outputs in isaaclab/logs remain excluded so the Spark's complete
# checkpoint fleet cannot be committed accidentally.  Artifacts copied into
# artifacts/ are intentional repository deliverables, including models/video.
*.pt
*.mp4
*.mov
*.webm
isaaclab/logs/
!artifacts/**/*.pt
!artifacts/**/*.mp4
!artifacts/**/*.mov
!artifacts/**/*.webm

# Local Python/tooling caches are reproducible and must not become experiment data.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/

# Scratch/reference renders and redundant handoff bundles stay outside Git. The
# source, curated checkpoints, metrics, logs, and videos they package live below.
tmp/
HEXAPOD_CHATGPT_PRO_HANDOFF*.zip
claude_hexapod_handoff_*.tar.gz
# Restart transport archives duplicate the extracted, hash-verified evidence.
# Keep them locally and on Spark; publish the curated files and inventories.
artifacts/restart_2026-09-14/**/*.tar.gz
robot/hexapod_leg_v2/meshes/

# setuptools editable-install metadata written by `uv sync`; regenerated on every sync.
*.egg-info/

