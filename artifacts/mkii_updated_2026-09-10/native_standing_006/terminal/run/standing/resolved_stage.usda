def Mesh "Ground" (
    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
)
{
    int[] faceVertexCounts = [3, 3]
    int[] faceVertexIndices = [0, 1, 2, 0, 2, 3]
    rel material:binding:physics = </StandingMaterial>
    uniform token physics:approximation = "none"
    point3f[] points = [(-40, -40, 0), (40, -40, 0), (40, 40, 0), (-40, 40, 0)]
}

def Material "StandingMaterial" (
    prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
)
{
    float physics:dynamicFriction = 1
    float physics:restitution = 0
    float physics:staticFriction = 1
    uniform token physxMaterial:frictionCombineMode = "multiply"
    uniform token physxMaterial:restitutionCombineMode = "multiply"
}

