#!/usr/bin/env bash
set -euo pipefail

isaac_lab_dir=/home/orionh/IsaacLab
run_name=2026-08-25_03-06-06_phase1_v5_anatomical_forward_scratch_seed52
run_dir=/workspace/hexapod/isaaclab/logs/rsl_rl/hexapod_robstride_phase1_anatomical_forward_v5_direct/${run_name}
artifact_host_dir=/home/orionh/HEXAPOD/artifacts/phase1_v5/evaluation
artifact_container_dir=/workspace/hexapod/artifacts/phase1_v5/evaluation

mkdir -p "${artifact_host_dir}"
chmod 0777 "${artifact_host_dir}"
cd "${isaac_lab_dir}"

docker compose \
  --env-file docker/.env.base \
  -f docker/docker-compose.yaml \
  --profile base \
  run \
  --rm \
  --name hexapod-phase1-v5-batch-eval \
  -w /workspace/hexapod/isaaclab \
  -e PYTHONPATH=/workspace/hexapod/isaaclab \
  -e PYTHONDONTWRITEBYTECODE=1 \
  -v /home/orionh/HEXAPOD:/workspace/hexapod:rw \
  --entrypoint /workspace/isaaclab/_isaac_sim/python.sh \
  isaac-lab-base \
  /workspace/hexapod/isaaclab/evaluate_checkpoint.py \
  --kit_args="--/exts/omni.kit.telemetry/skipDeferredStartup=true --/app/extensions/excluded/4=omni.kit.telemetry" \
  --task Isaac-Velocity-Flat-Hexapod-RobStride-Phase1-Anatomical-V5-Direct-v0 \
  --checkpoint "${run_dir}/model_175.pt" \
  --checkpoint "${run_dir}/model_200.pt" \
  --checkpoint "${run_dir}/model_225.pt" \
  --checkpoint "${run_dir}/model_250.pt" \
  --checkpoint "${run_dir}/model_275.pt" \
  --checkpoint "${run_dir}/model_300.pt" \
  --checkpoint "${run_dir}/model_325.pt" \
  --checkpoint "${run_dir}/model_350.pt" \
  --checkpoint "${run_dir}/model_400.pt" \
  --checkpoint "${run_dir}/model_450.pt" \
  --checkpoint "${run_dir}/model_499.pt" \
  --command 0.15 0 0 \
  --command 0.25 0 0 \
  --command 0.30 0 0 \
  --seconds 10 \
  --warmup-steps 25 \
  --seed 52 \
  --disable-randomization \
  --json "${artifact_container_dir}/eval_batch_nominal.json" \
  >"${artifact_host_dir}/eval_batch_nominal.log" 2>&1
